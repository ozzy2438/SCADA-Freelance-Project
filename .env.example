# Copy to a gitignored .env and fill the required secrets there.
#   python -m ges_intel.cli init-env
# Compose interpolates that file; do not put live passwords in this example.

API_KEY=dev-api-key
POSTGRES_USER=ges
POSTGRES_DB=ges
TARIFF_USD_PER_KWH=0.10
LOG_LEVEL=INFO
DUCKDB_PATH=/data/telemetry.duckdb
MODEL_PATH=/artifacts/model.joblib
MODEL_METADATA_PATH=/artifacts/model_metadata.json
API_BASE_URL=http://api:8000

# Required for docker compose (set in .env, not in git):
# POSTGRES_PASSWORD
# DATABASE_URL
